{
  // Plantão Fácil: app (arquivos estáticos de dist/) + API de sessões em /api/sessoes.
  // A API usa Durable Objects com SQLite (disponíveis no plano grátis); não há KV nem segredos aqui.
  "name": "prescricao",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSAO", "class_name": "Sessao" },
      { "name": "ENTRADA", "class_name": "Entrada" },
      { "name": "LIMITADOR", "class_name": "Limitador" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Sessao", "Entrada", "Limitador"] }
  ],
  "routes": [
    { "pattern": "prescricao.mhvl.com.br", "custom_domain": true }
  ]
}
