{
  // Plantão Fácil: app (arquivos estáticos de dist/) + API de sessões em /api/sessoes.
  // Antes de publicar: criar o namespace KV (npx wrangler kv namespace create SESSOES)
  // e colar o id abaixo. Não há segredos neste arquivo.
  "name": "prescricao",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "SESSOES", "id": "fd86d0b0252546dcb533130ce05782e8" }
  ],
  "routes": [
    { "pattern": "prescricao.mhvl.com.br", "custom_domain": true }
  ]
}
